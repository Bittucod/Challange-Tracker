---
import AppLayout from '../../layouts/AppLayout.astro';
import Icons from '../../components/Icons.astro';
import StakeBadge from '../../components/StakeBadge.astro';
import BadgesShowcase from '../../components/BadgesShowcase.astro';
import { getUserFromCookies } from '../../lib/auth';
import { db } from '../../lib/db';
import { getChallengeStakeCommitment } from '../../lib/stakes';
import { evaluateAndSyncUserBadges } from '../../lib/badges';
import type { Challenge, User } from '../../lib/types';

const user = getUserFromCookies(Astro.cookies);
if (!user) {
  return Astro.redirect('/login');
}

const evaluatedBadges = evaluateAndSyncUserBadges(user.id);
const earnedBadgesCount = evaluatedBadges.filter((b) => b.isUnlocked).length;

const userChallenges = db
  .prepare('SELECT * FROM challenges WHERE user_id = ? AND is_archived = 0 ORDER BY created_at DESC')
  .all(user.id) as Challenge[];

const activeChallenges = userChallenges.filter((c) => c.settlement_status !== 'refunded' && c.settlement_status !== 'forfeited');
const completedChallenges = userChallenges.filter((c) => c.settlement_status === 'refunded' || evaluatedBadges.some((b) => b.key === 'challenge_finisher' && b.isUnlocked));

const initial = user.name ? user.name.charAt(0).toUpperCase() : 'U';
---

<AppLayout title={`${user.name}'s Profile — StreakGrid`}>
  <div class="profile-page-container">
    <!-- User Profile Header Card -->
    <div class="profile-hero-card">
      <div class="profile-left">
        <div class="profile-avatar-large">
          {user.avatar_url ? (
            <img src={user.avatar_url} alt={user.name} class="avatar-img-lg" />
          ) : (
            <span class="avatar-letter">{initial}</span>
          )}
        </div>
        <div class="profile-name-block">
          <h1 class="profile-display-name">{user.name}</h1>
          <span class="profile-email-sub">{user.email}</span>
          <span class="profile-joined-text">
            Member since {new Date(user.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </span>
        </div>
      </div>

      <div class="profile-summary-stats">
        <a href="#badges-showcase-section" class="pstat-item pstat-clickable" title="Click to view all earned and in-progress badges">
          <span class="pstat-num">{earnedBadgesCount}</span>
          <span class="pstat-label">Badges Earned</span>
        </a>
        <div class="pstat-item">
          <span class="pstat-num">{userChallenges.length}</span>
          <span class="pstat-label">Challenges</span>
        </div>
      </div>
    </div>

    <!-- Gamified Badges Showcase Section -->
    <BadgesShowcase badges={evaluatedBadges} />

    <!-- Active Challenges Grid -->
    <div class="profile-section-card">
      <div class="section-card-head">
        <h2 class="section-title">Active Challenges</h2>
        <a href="/app/challenges/new" class="btn btn-secondary btn-sm">
          <Icons name="plus" size={13} />
          <span>New</span>
        </a>
      </div>

      {activeChallenges.length === 0 ? (
        <p class="empty-text">No active challenges. Start your next goal today.</p>
      ) : (
        <div class="challenges-list-grid">
          {activeChallenges.map((c) => {
            const comm = getChallengeStakeCommitment(c.id);
            return (
              <div class="challenge-item-card">
                <div class="c-card-top">
                  <strong class="c-card-name">
                    <a href={`/app/challenges/${c.id}`}>{c.name}</a>
                  </strong>
                  <StakeBadge commitment={comm} challengeType={c.challenge_type} />
                </div>
                <div class="c-card-meta">
                  <span>{c.duration} Days</span>
                  <span>{c.start_date} → {c.end_date}</span>
                </div>
                <div class="c-card-actions">
                  <a href={`/app/challenges/${c.id}`} class="btn btn-secondary btn-sm">Open Tracker</a>
                  {c.visibility !== 'private' && (
                    <a href={`/challenge/${c.id}`} class="btn btn-outline btn-sm">Public View</a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</AppLayout>

<style>
  .profile-page-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .profile-hero-card,
  .profile-section-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    padding: 24px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .profile-hero-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .profile-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .profile-avatar-large {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .avatar-img-lg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-letter {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-text);
  }

  .profile-name-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .profile-display-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
  }

  .profile-email-sub {
    font-size: 13px;
    color: var(--color-muted);
  }

  .profile-joined-text {
    font-size: 11px;
    color: var(--color-muted);
    margin-top: 2px;
  }

  .profile-summary-stats {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .pstat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pstat-clickable {
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .pstat-clickable:hover {
    transform: translateY(-2px);
  }

  .pstat-clickable:hover .pstat-num {
    color: var(--color-primary);
  }

  .pstat-clickable:hover .pstat-label {
    color: var(--color-primary-hover);
  }

  .pstat-num {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-text);
  }

  .pstat-label {
    font-size: 11px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .section-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
  }

  .section-sub-info {
    font-size: 12px;
    color: var(--color-muted);
  }

  .badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }

  .badge-card {
    background: #FAF9F5;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 12px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .badge-icon-wrap {
    font-size: 22px;
  }

  .badge-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .badge-card-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
  }

  .badge-card-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  .badge-awarded-date {
    font-size: 10px;
    color: var(--color-muted);
    margin-top: 4px;
  }

  .empty-badges-box {
    text-align: center;
    padding: 30px 16px;
    color: var(--color-muted);
    font-size: 13px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .empty-badge-icon {
    font-size: 28px;
  }

  .challenges-list-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .challenge-item-card {
    background: #FAF9F5;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .c-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .c-card-name a {
    color: var(--color-text);
  }

  .c-card-name a:hover {
    color: var(--color-primary-hover);
  }

  .c-card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--color-muted);
  }

  .c-card-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  @media (max-width: 640px) {
    .profile-hero-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .challenges-list-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
