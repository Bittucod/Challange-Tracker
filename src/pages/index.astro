<script>
  import { triggerConfetti } from '../scripts/confetti';

  // Interactive demo cell toggling
  const demoCells = document.querySelectorAll('.demo-cell');
  const rowSummary = document.getElementById('demo-row-summary');

  demoCells.forEach((cell) => {
    cell.addEventListener('click', () => {
      const c = cell as HTMLElement;
      const isCompleted = c.classList.contains('status-completed');
      const symbol = c.querySelector('.cell-symbol');

      if (isCompleted) {
        c.classList.remove('status-completed', 'animate-pop');
        c.classList.add('status-pending');
        if (symbol) symbol.textContent = '○';
      } else {
        c.classList.remove('status-pending', 'status-missed', 'status-na');
        c.classList.add('status-completed', 'animate-pop');
        if (symbol) symbol.textContent = '✓';
      }

      // Check if all today's cells completed
      const todayRow = document.querySelector('.tracker-row-today');
      if (todayRow) {
        const completedInRow = todayRow.querySelectorAll('.status-completed').length;
        if (rowSummary) {
          if (completedInRow >= 5) {
            rowSummary.textContent = '★ Perfect';
            rowSummary.className = 'day-indicator indicator-success';
            triggerConfetti();
          } else {
            rowSummary.textContent = `${completedInRow}/5`;
            rowSummary.className = 'day-indicator indicator-success';
          }
        }
      }
    });
  });
</script>
