---
import Layout from '../layouts/Layout.astro';
import Icons from '../components/Icons.astro';
import { getUserFromCookies } from '../lib/auth';

const user = getUserFromCookies(Astro.cookies);
---

<Layout
  title="StreakGrid — Real-Stakes Accountability & Challenge OS"
  description="Make your challenge worth showing up for. Put a real commitment behind your 30, 50, or 100-day goal. Track every day. Complete the challenge and get your stake back according to the rules."
>
  <div class="landing-page">
    <!-- Navigation Bar -->
    <header class="landing-header">
      <div class="landing-header-inner">
        <a href="/" class="landing-brand">
          <div class="brand-badge">✓</div>
          <span class="brand-title">StreakGrid</span>
        </a>

        <div class="landing-center-nav">
          <a href="/community" class="landing-nav-link">Community</a>
          <a href="#how-it-works" class="landing-nav-link">How It Works</a>
          <a href="#trust" class="landing-nav-link">Accountability Staking</a>
        </div>

        <div class="landing-nav-actions">
          {user ? (
            <a href="/app" class="btn btn-primary btn-sm">Go to Dashboard</a>
          ) : (
            <>
              <a href="/login" class="btn btn-secondary btn-sm">Sign In</a>
              <a href="/signup" class="btn btn-primary btn-sm">Start Challenge</a>
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-container">
        <div class="hero-pill">
          <span class="pill-badge">Accountability & Commitment</span>
          <span class="pill-text">Built for 30, 50, and 100-day challenges</span>
        </div>

        <h1 class="hero-headline">
          Make your challenge<br class="hero-br" /> worth showing up for.
        </h1>

        <p class="hero-subtitle">
          Set a goal. Put a real commitment behind it. Track every day with simple spreadsheet boxes. Complete the challenge and get your stake back according to the rules.
        </p>

        <div class="hero-cta-group">
          <a href="/signup" class="btn btn-primary hero-btn">
            <span>Start a Challenge</span>
            <Icons name="arrow-right" size={16} />
          </a>
          <a href="/community" class="btn btn-secondary hero-btn">
            <Icons name="share" size={15} />
            <span>Explore Community</span>
          </a>
        </div>

        <!-- Interactive Hero Mock Tracker -->
        <div class="hero-mock-wrapper">
          <div class="mock-card">
            <div class="mock-card-header">
              <div class="mock-header-left">
                <span class="badge badge-neutral">Day 63 of 100</span>
                <span class="badge badge-streak" id="mock-streak-badge">🔥 21 day streak</span>
                <span class="badge badge-stake-active">● ₹1,000 committed</span>
                <span class="badge badge-success">88% consistency</span>
              </div>
              <div class="mock-header-right">
                <span class="mock-hint">Interactive demo — tap any cell:</span>
              </div>
            </div>

            <!-- Demo Table Grid -->
            <div class="tracker-container">
              <table class="tracker-table">
                <thead>
                  <tr>
                    <th class="col-date">Date</th>
                    <th>
                      <div class="activity-header-content">
                        <Icons name="x" size={14} /> <span>X</span>
                      </div>
                    </th>
                    <th>
                      <div class="activity-header-content">
                        <Icons name="linkedin" size={14} /> <span>LinkedIn</span>
                      </div>
                    </th>
                    <th>
                      <div class="activity-header-content">
                        <Icons name="youtube" size={14} /> <span>YouTube</span>
                      </div>
                    </th>
                    <th>
                      <div class="activity-header-content">
                        <Icons name="reddit" size={14} /> <span>Reddit</span>
                      </div>
                    </th>
                    <th>
                      <div class="activity-header-content">
                        <Icons name="instagram" size={14} /> <span>Instagram</span>
                      </div>
                    </th>
                    <th class="col-status-summary">Day Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="tracker-row tracker-row-past">
                    <td class="col-date">
                      <div class="date-cell-inner">
                        <span class="day-num">D61</span>
                        <span class="date-short">Sep 18</span>
                        <span class="day-dow">Thu</span>
                      </div>
                    </td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-na demo-cell"><span class="cell-symbol">—</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td class="col-status-summary"><span class="day-indicator indicator-success">★ Perfect</span></td>
                  </tr>

                  <tr class="tracker-row tracker-row-past">
                    <td class="col-date">
                      <div class="date-cell-inner">
                        <span class="day-num">D62</span>
                        <span class="date-short">Sep 19</span>
                        <span class="day-dow">Fri</span>
                      </div>
                    </td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-missed demo-cell"><span class="cell-symbol">✕</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td class="col-status-summary"><span class="day-indicator indicator-success">✓ Done</span></td>
                  </tr>

                  <tr class="tracker-row tracker-row-today">
                    <td class="col-date">
                      <div class="date-cell-inner">
                        <span class="day-num">D63</span>
                        <span class="date-short">Sep 20</span>
                        <span class="day-dow">Sat</span>
                        <span class="today-tag">TODAY</span>
                      </div>
                    </td>
                    <td><div class="grid-cell status-completed demo-cell has-note" title="Note: Shipped onboarding modal"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-pending demo-cell" id="demo-target-cell"><span class="cell-symbol">○</span></div></td>
                    <td><div class="grid-cell status-completed demo-cell"><span class="cell-symbol">✓</span></div></td>
                    <td><div class="grid-cell status-pending demo-cell"><span class="cell-symbol">○</span></div></td>
                    <td class="col-status-summary"><span class="day-indicator indicator-success" id="demo-row-summary">3/5</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="mock-footer">
              <div class="philosophy-quote">
                «Put something meaningful on the line. Show up. Complete your challenge. Get your stake back.»
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust & Accountability Staking Section -->
    <section id="trust" class="section-trust">
      <div class="section-container">
        <div class="section-heading-block">
          <span class="section-tag">Accountability, Not Gambling</span>
          <h2 class="section-title">How Real-Stakes Accountability Works</h2>
          <p class="section-sub">
            Built for ambitious founders, builders, and creators who need real skin in the game.
          </p>
        </div>

        <div class="trust-grid">
          <div class="trust-card">
            <div class="trust-step-num">01</div>
            <h3 class="trust-card-title">Choose Your Stake</h3>
            <p class="trust-card-desc">
              Track 100% free, or select an optional stake amount (e.g. ₹1,000) within configured limits to put real commitment behind your goal.
            </p>
          </div>

          <div class="trust-card">
            <div class="trust-step-num">02</div>
            <h3 class="trust-card-title">Locked Rules Upfront</h3>
            <p class="trust-card-desc">
              Duration, success rules, and daily deadlines are shown clearly before payment. Once active, rules are locked to protect commitment integrity.
            </p>
          </div>

          <div class="trust-card">
            <div class="trust-step-num">03</div>
            <h3 class="trust-card-title">Held in Regulated Escrow</h3>
            <p class="trust-card-desc">
              Your deposit is held securely in escrow reserve. It is not operating capital and never pooled into gambling contests.
            </p>
          </div>

          <div class="trust-card">
            <div class="trust-step-num">04</div>
            <h3 class="trust-card-title">100% Refund on Completion</h3>
            <p class="trust-card-desc">
              Complete your challenge according to the published rules and your stake is returned in full. If you fail, the stake is forfeited respectfully under terms.
            </p>
          </div>
        </div>

        <div class="trust-links-strip">
          <a href="/rules" class="trust-link">View Official Challenge Rules ↗</a>
          <a href="/refund-policy" class="trust-link">View Refund & Settlement Policy ↗</a>
          <a href="/terms" class="trust-link">View Terms of Service ↗</a>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="section-how">
      <div class="section-container">
        <div class="section-heading-block">
          <span class="section-tag">How It Works</span>
          <h2 class="section-title">Minimal friction. Unbroken momentum.</h2>
          <p class="section-sub">A daily ritual that takes less than 10 seconds every day.</p>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <span class="step-number">01</span>
            <h3 class="step-title">Set Your Challenge</h3>
            <p class="step-desc">Pick your duration (30, 50, 100 days) and list custom activities: coding, posting, gym, or shipping.</p>
          </div>

          <div class="step-card">
            <span class="step-number">02</span>
            <h3 class="step-title">Simple Boxes On Top</h3>
            <p class="step-desc">Open the app, see Today immediately highlighted, and tap your boxes. One tap completes. Zero fluff.</p>
          </div>

          <div class="step-card">
            <span class="step-number">03</span>
            <h3 class="step-title">Automated Streaks & Milestones</h3>
            <p class="step-desc">Calculations handle streaks, exempt days, and custom success criteria automatically. Hit milestones with subtle celebration.</p>
          </div>

          <div class="step-card">
            <span class="step-number">04</span>
            <h3 class="step-title">Screenshot-Worthy Share Cards</h3>
            <p class="step-desc">Generate pixel-perfect image cards for Twitter/X, LinkedIn, and Stories in one click.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Highlights Grid -->
    <section class="section-features">
      <div class="section-container">
        <div class="section-heading-block">
          <span class="section-tag">Product Architecture</span>
          <h2 class="section-title">Engineered for long-term consistency</h2>
        </div>

        <div class="features-grid">
          <div class="feature-item">
            <div class="feature-icon"><Icons name="target" size={20} /></div>
            <h4 class="feature-title">Spreadsheet Simplicity</h4>
            <p class="feature-desc">Sticky date columns, sticky activity headers, and immediate keyboard and touch navigation.</p>
          </div>

          <div class="feature-item">
            <div class="feature-icon"><Icons name="note" size={20} /></div>
            <h4 class="feature-title">Hidden Notes Metadata</h4>
            <p class="feature-desc">Store notes on individual cells without cluttering the grid. A subtle dot indicates notes exist.</p>
          </div>

          <div class="feature-item">
            <div class="feature-icon"><Icons name="flame" size={20} /></div>
            <h4 class="feature-title">Robust Streak Engine</h4>
            <p class="feature-desc">Configurable success rules: all activities, at least one, or custom minimums. Exemptions supported via "—".</p>
          </div>

          <div class="feature-item">
            <div class="feature-icon"><Icons name="trophy" size={20} /></div>
            <h4 class="feature-title">Consistency Heatmap</h4>
            <p class="feature-desc">GitHub contribution-style heatmaps with calibrated green intensity levels representing overall consistency.</p>
          </div>

          <div class="feature-item">
            <div class="feature-icon"><Icons name="code" size={20} /></div>
            <h4 class="feature-title">Mobile-First PWA</h4>
            <p class="feature-desc">Install directly to your home screen. Continue tracking seamlessly with local offline queueing.</p>
          </div>

          <div class="feature-item">
            <div class="feature-icon"><Icons name="share" size={20} /></div>
            <h4 class="feature-title">Public Community Feed</h4>
            <p class="feature-desc">Optionally share your progress, receive peer encouragement, and watch others show up daily.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Banner -->
    <section class="section-cta">
      <div class="cta-inner">
        <h2 class="cta-heading">Ready to start your next challenge?</h2>
        <p class="cta-sub">Free or staked. Your streak begins with Day 1.</p>
        <div class="cta-btn-wrap">
          <a href="/signup" class="btn btn-primary hero-btn">
            <span>Create Your Account</span>
            <Icons name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="landing-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="brand-badge">✓</div>
          <span>StreakGrid</span>
        </div>

        <div class="footer-links">
          <a href="/community">Community</a>
          <a href="/rules">Rules</a>
          <a href="/refund-policy">Refund Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="/privacy">Privacy Policy</a>
        </div>

        <p class="footer-copy">© 2026 StreakGrid. Complex calculations underneath. Simple boxes on top.</p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .landing-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .landing-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 247, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .landing-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .landing-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 16px;
    color: var(--color-text);
  }

  .brand-badge {
    width: 26px;
    height: 26px;
    background: var(--color-primary);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 15px;
  }

  .landing-center-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .landing-nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color 0.1s ease;
  }

  .landing-nav-link:hover {
    color: var(--color-text);
  }

  .landing-nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Hero Section */
  .hero-section {
    padding: 60px 20px 80px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-container {
    max-width: 1080px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 5px;
    border-radius: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .pill-badge {
    padding: 3px 9px;
    border-radius: 12px;
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    font-size: 11px;
    font-weight: 700;
  }

  .pill-text {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .hero-headline {
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text);
    max-width: 760px;
  }

  .hero-subtitle {
    font-size: 17px;
    color: var(--color-text-secondary);
    max-width: 620px;
    line-height: 1.55;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .hero-btn {
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
  }

  .badge-stake-active {
    background: #FEF3C7;
    color: #B45309;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }

  /* Mock Card */
  .hero-mock-wrapper {
    width: 100%;
    margin-top: 24px;
  }

  .mock-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-modal);
    box-shadow: var(--shadow-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: left;
  }

  .mock-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mock-header-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .mock-hint {
    font-size: 11px;
    color: var(--color-muted);
    font-style: italic;
  }

  .mock-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
  }

  .philosophy-quote {
    font-size: 12px;
    color: var(--color-muted);
    font-style: italic;
  }

  .activity-header-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: 12px;
  }

  .date-cell-inner {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 4px;
  }

  .day-num {
    font-weight: 700;
    color: var(--color-text);
  }

  .date-short {
    color: var(--color-text-secondary);
  }

  .day-dow {
    color: var(--color-muted);
    font-size: 11px;
  }

  .today-tag {
    font-size: 9px;
    font-weight: 800;
    color: var(--color-primary-hover);
    background: var(--color-primary-light);
    padding: 1px 4px;
    border-radius: 3px;
  }

  .day-indicator {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 6px;
    border-radius: 4px;
  }

  .indicator-success {
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
  }

  /* Trust Section */
  .section-trust {
    background: #FFFFFF;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 70px 20px;
  }

  .section-container {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section-heading-block {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .section-tag {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-streak-hover);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-title {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .section-sub {
    font-size: 15px;
    color: var(--color-text-secondary);
    max-width: 520px;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .trust-card {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-panel);
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .trust-step-num {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-primary-hover);
  }

  .trust-card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
  }

  .trust-card-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .trust-links-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 10px;
  }

  .trust-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary-hover);
  }

  .trust-link:hover {
    text-decoration: underline;
  }

  /* How it works */
  .section-how,
  .section-features {
    padding: 70px 20px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .step-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .step-number {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-muted);
  }

  .step-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
  }

  .step-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .feature-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
  }

  .feature-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  /* Final CTA */
  .section-cta {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 70px 20px;
    text-align: center;
  }

  .cta-inner {
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
